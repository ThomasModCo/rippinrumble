{
  "game": "Rippin Rumble",
  "configVersion": 1,
  "date": "2026-10-05",
  "sdkMode": "none",
  "math": {
    "track": "non-Ragency",
    "engine": "GnarOne Rip & Rumble (rumble-engine)",
    "source": "https://github.com/Danvid1009/gnarone-game-math @ 7c4feaf",
    "preset": "sheet-v4",
    "rtp": 0.95,
    "changesRequested": "none (used as published)",
    "packSize": 5,
    "paysPerCardCredits": { "legendary": 3, "rare": 1, "uncommon": 0.5, "common": 0 },
    "countMultiplier": { "1": 1, "2": 2, "3": 3, "4": 10, "5": 100 }
  },
  "money": {
    "note": "All amounts in code are integer minor units. Players only ever see Coins.",
    "minorUnitsPerCoin": 100,
    "coinsPerEngineCredit": 1,
    "startingBalanceCoins": 1250,
    "startingBalanceMinor": 125000,
    "coinDisplayDecimals": "up to 1 (an uncommon pays 0.5 Coins at the lowest Base level)"
  },
  "playTypes": {
    "BASE": {
      "label": "Base",
      "packImage": "boosterpack1",
      "packs": 1,
      "levelsCoins": [5, 10, 25, 50],
      "levelsMinor": [500, 1000, 2500, 5000],
      "defaultLevelCoins": 5,
      "topWinMultiple": 300
    },
    "BOOSTED": {
      "label": "Boosted",
      "packImage": "boosterpack2",
      "packs": 1,
      "levelsCoins": [10, 20, 50, 100],
      "levelsMinor": [1000, 2000, 5000, 10000],
      "defaultLevelCoins": 10,
      "topWinMultiple": 150
    }
  },
  "notInFirstBuild": {
    "BASE_BUNDLE": "11 packs for the price of 10; needs the multi-pack reveal",
    "BOOSTED_BUNDLE": "also not in the live SDK play-type list"
  },
  "autoplay": {
    "rounds": 10,
    "stopOn": ["legendary card revealed", "balance below the selected play level", "player taps Autoplay again"]
  },
  "turbo": {
    "effect": "shortens the rip and reveal animations; never changes the result"
  },
  "deck": {
    "active": "chimera",
    "cardData": "docs/cards_chimera.json",
    "counts": { "legendary": 5, "rare": 13, "uncommon": 14, "common": 18 },
    "cardSelection": "cosmetic: the provider returns rarity counts, the client picks distinct cards of each rarity at random"
  },
  "gallery": {
    "inFirstBuild": true,
    "persistence": "session only"
  },
  "provider": {
    "interface": ["open()", "play(amountMinor, playType)", "collect(roundId)"],
    "default": "LocalProvider wrapping createGame({ preset: 'sheet-v4' })",
    "later": "SdkProvider over sdk.rippinrumble (openGame, getValidBets, placeBet, collect)"
  }
}
